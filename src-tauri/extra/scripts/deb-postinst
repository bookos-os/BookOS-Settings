#!/bin/sh
# Debian/Ubuntu postinst — runs after dpkg installs files.
set -e

if [ -x /opt/bookos-ai/setup.sh ]; then
    echo "Setting up BookOS AI venv..."
    /opt/bookos-ai/setup.sh || echo "WARN: AI venv setup failed"
fi

systemctl daemon-reload >/dev/null 2>&1 || true

# Este guion es también el preinst. Book Share se activa solo la primera vez
# que llega (instalación nueva o actualización desde una versión sin él): el
# preinst lo apunta si la unidad aún no está y el postinst («configure») lo
# activa. Así se respeta a quien lo haya desactivado con --global disable.
case "$1" in
    install|upgrade)
        [ -e /usr/lib/systemd/user/bookos-bookshare.service ] || : > /run/bookos-bookshare-nuevo
        ;;
    configure)
        if [ -e /run/bookos-bookshare-nuevo ]; then
            rm -f /run/bookos-bookshare-nuevo
            systemctl --global enable bookos-bookshare.service >/dev/null 2>&1 || true
        fi
        ;;
esac

cat <<EOF
BookOS Settings installed.
Enable optional services if you want them running:
    sudo systemctl enable --now bookos-battery-adaptive.timer
    sudo systemctl enable --now bookos-battery-logger.timer
    sudo systemctl enable --now bookos-battery-train.timer
    sudo systemctl enable --now bookos-hw-perms.service
EOF

exit 0
