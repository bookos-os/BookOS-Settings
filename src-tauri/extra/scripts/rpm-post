#!/bin/sh
systemctl daemon-reload >/dev/null 2>&1 || true
# Book Share recibe con Ajustes cerrado solo si arranca con la sesión. Solo
# se activa la primera vez que llega (ver rpm-pre): en las actualizaciones se
# respeta a quien lo haya desactivado con `systemctl --global disable`.
if [ -e /run/bookos-bookshare-nuevo ]; then
    rm -f /run/bookos-bookshare-nuevo
    systemctl --global enable bookos-bookshare.service >/dev/null 2>&1 || true
fi
exit 0
